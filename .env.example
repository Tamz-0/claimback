# Copy this file to ".env" and fill in the values. NEVER commit .env to Git.

# Supabase -> Project -> Connect -> "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Encryption key for hidden identifying details. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if you lose it, stored private details can no longer be read.
FIELD_ENCRYPTION_KEY=

DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
